diff --git a/web_src/js/components/RepoActionView.test.js b/web_src/js/components/RepoActionView.test.js
index e66c7d5..01656c3 100644
--- a/web_src/js/components/RepoActionView.test.js
+++ b/web_src/js/components/RepoActionView.test.js
@@ -613,3 +613,63 @@ test('view with pre-execution error', async () => {
   expect(block.exists()).toBe(true);
   expect(block.text()).toBe('pre-execution error Oops, I dropped it.');
 });
+
+test('full screen button and Escape', async () => {
+  document.body.innerHTML = `
+    <div class="full height">
+      <div id="navbar"></div>
+      <div class="page-content repository"><div id="mount-point"></div></div>
+      <div class="page-footer"></div>
+    </div>`;
+  const wrapper = mount(RepoActionView, {
+    props: defaultTestProps,
+    attachTo: '#mount-point',
+  });
+  await flushPromises();
+
+  const pressEscape = async () => {
+    document.dispatchEvent(new KeyboardEvent('keydown', {key: 'Escape'}));
+    await flushPromises();
+  };
+  // Full screen moves the log panel out of the component root, so query the document
+  const click = async (selector) => {
+    document.querySelector(selector).click();
+    await flushPromises();
+  };
+  const gearMenuOpen = () => document.querySelector('.job-gear-dropdown .action-job-menu') !== null;
+  const isFullScreen = () => document.querySelector('.full.height > .action-view-right') !== null;
+
+  // Full screen is no longer an item in the gear menu
+  await click('.job-gear-dropdown');
+  expect(document.querySelectorAll('.job-gear-dropdown .action-job-menu .item').length).toEqual(3);
+  wrapper.vm.closeDropdown();
+  await flushPromises();
+
+  await click('.job-fullscreen-toggle');
+  expect(isFullScreen()).toBe(true);
+  expect(document.querySelector('.job-fullscreen-toggle').getAttribute('aria-pressed')).toEqual('true');
+  expect(document.querySelector('#navbar').classList.contains('tw-hidden')).toBe(true);
+
+  // Escape closes an open menu before leaving full screen
+  await click('.job-gear-dropdown');
+  expect(gearMenuOpen()).toBe(true);
+  await pressEscape();
+  expect(gearMenuOpen()).toBe(false);
+  expect(isFullScreen()).toBe(true);
+
+  await pressEscape();
+  expect(isFullScreen()).toBe(false);
+  expect(document.querySelector('#navbar').classList.contains('tw-hidden')).toBe(false);
+
+  // Escape outside full screen does nothing
+  await pressEscape();
+  expect(isFullScreen()).toBe(false);
+
+  await click('.job-fullscreen-toggle');
+  expect(isFullScreen()).toBe(true);
+  await click('.job-fullscreen-toggle');
+  expect(isFullScreen()).toBe(false);
+
+  wrapper.unmount();
+  document.body.innerHTML = '';
+});
