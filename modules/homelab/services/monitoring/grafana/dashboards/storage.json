{
  "uid": "storage",
  "title": "Storage",
  "tags": [
    "storage",
    "zfs"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "pool",
        "label": "Pool",
        "type": "query",
        "query": {
          "query": "label_values(zfs_pool_size_bytes, pool)",
          "refId": "pool"
        },
        "definition": "label_values(zfs_pool_size_bytes, pool)",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": true,
        "hide": 0,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "bargauge",
      "title": "Pool usage",
      "description": "How full each ZFS pool is, including snapshots.",
      "gridPos": {
        "h": 6,
        "w": 16,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * zfs_pool_allocated_bytes / zfs_pool_size_bytes",
          "instant": true,
          "range": false,
          "legendFormat": "{{pool}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "max": 100,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "valueMode": "color",
        "showUnfilled": true,
        "namePlacement": "left",
        "sizing": "auto",
        "maxVizHeight": 40,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Free space",
      "description": "Space that can still be written to each ZFS pool. This matches df.",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "zfs_dataset_available_bytes{name!~\".+/.+\"}",
          "instant": true,
          "range": false,
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "All pools capacity",
      "description": "Space used by each ZFS pool, stacked up to the combined capacity of all pools.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "zfs_pool_allocated_bytes",
          "legendFormat": "{{pool}}"
        },
        {
          "refId": "C",
          "expr": "sum(zfs_pool_size_bytes)",
          "legendFormat": "capacity"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 70,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "capacity"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none",
                  "group": "A"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ],
          "showLegend": true,
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Single pool breakdown",
      "repeat": "pool",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 16
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "$pool capacity",
      "description": "Space used by each dataset in the selected pool, stacked up to its total capacity. Datasets under 1 GiB are grouped as other.",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "refId": "A",
          "expr": "zfs_dataset_used_bytes{pool=\"$pool\",type=\"filesystem\",name=~\".+/.+\",name!=\"tank/services\"} >= 1073741824",
          "legendFormat": "{{name}}"
        },
        {
          "refId": "B",
          "expr": "sum(zfs_dataset_used_bytes{pool=\"$pool\",type=\"filesystem\",name=~\".+/.+\",name!=\"tank/services\"} < 1073741824)",
          "legendFormat": "other"
        },
        {
          "refId": "C",
          "expr": "zfs_pool_size_bytes{pool=\"$pool\"}",
          "legendFormat": "capacity"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 70,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "capacity"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none",
                  "group": "A"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ],
          "showLegend": true,
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Largest datasets",
      "description": "Space used by each dataset, including its snapshots.",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sort_desc(topk(12, zfs_dataset_used_bytes{pool=\"$pool\",type=\"filesystem\",name=~\".+/.+\",name!=\"tank/services\",name!~\".+/reserved\"}))",
          "instant": true,
          "range": false,
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "valueMode": "color",
        "showUnfilled": true,
        "namePlacement": "left",
        "sizing": "auto",
        "maxVizHeight": 40,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {
          "titleSize": 13,
          "valueSize": 16
        }
      }
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Space held by snapshots",
      "description": "Used minus live data. This is the space that df does not show and that deleting files does not free.",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 29
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sort_desc(topk(12, zfs_dataset_used_bytes{pool=\"$pool\",type=\"filesystem\",name=~\".+/.+\",name!=\"tank/services\",name!~\".+/reserved\"} - zfs_dataset_used_by_dataset_bytes > 0))",
          "instant": true,
          "range": false,
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "valueMode": "color",
        "showUnfilled": true,
        "namePlacement": "left",
        "sizing": "auto",
        "maxVizHeight": 40,
        "minVizHeight": 16,
        "minVizWidth": 8,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {
          "titleSize": 13,
          "valueSize": 16
        }
      }
    }
  ]
}
